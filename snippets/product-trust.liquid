{%- comment -%}
  Usage:
    render 'product-trust', details: ..., shipping: ..., returns: ...

  Answers the three questions a $5 physical product raises right next to the
  buy button, instead of burying them in a policy page. Native <details> so
  it's keyboard operable and searchable with no JavaScript. Each panel is
  skipped when its setting is empty.
{%- endcomment -%}

{%- assign has_any = false -%}
{%- if details != blank or shipping != blank or returns != blank -%}
  {%- assign has_any = true -%}
{%- endif -%}

{%- if has_any -%}
  <div class="product-trust">
    {%- if details != blank -%}
      <details class="product-trust__item">
        <summary class="product-trust__q">
          <span>What you're getting</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="product-trust__a">{{ details }}</div>
      </details>
    {%- endif -%}

    {%- if shipping != blank -%}
      <details class="product-trust__item">
        <summary class="product-trust__q">
          <span>Shipping</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="product-trust__a">{{ shipping }}</div>
      </details>
    {%- endif -%}

    {%- if returns != blank -%}
      <details class="product-trust__item">
        <summary class="product-trust__q">
          <span>Returns</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="product-trust__a">{{ returns }}</div>
      </details>
    {%- endif -%}
  </div>
{%- endif -%}
