{%- comment -%}
  Renders a Shopify link list to the full three levels the admin allows, so a
  menu built in Navigation just works on the storefront with no theme edit.

  The markup is identical for the desktop bar and the mobile drawer — only the
  ancestor (.site-header__nav / .mobile-nav__links) changes how it's painted.
  Keep it that way; two copies of this loop is how the two navs drift apart.

  A parent keeps its own <a>, because Shopify parent links have real URLs and
  swallowing one makes that page unreachable. The chevron is a separate button
  so a tap on the label navigates and a tap on the chevron opens — no guessing
  which one a touch meant.

  Level 3 has no toggle: those items render as a static group inside the open
  panel. Three levels is the admin ceiling, so nothing is lost by stopping the
  collapsing here, and a flyout-inside-a-flyout is miserable on a phone.

  Accepts:
    linklist  — a link_list setting (required)
    id_prefix — unique per call site; submenu ids must not collide (required)
{%- endcomment -%}

{%- liquid
  assign chevron = '<svg class="nav-tree__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"/></svg>'
-%}

<ul class="nav-tree" role="list">
  {%- for link in linklist.links -%}
    {%- assign submenu_id = id_prefix | append: '-submenu-' | append: forloop.index -%}
    <li class="nav-tree__item{% if link.links.size > 0 %} has-submenu{% endif %}">
      <div class="nav-tree__row">
        <a
          href="{{ link.url }}"
          class="nav-tree__link"
          {% if link.active %}aria-current="page"{% endif %}
          {% if link.child_active %}data-child-active="true"{% endif %}
        >{{ link.title | escape }}</a>

        {%- if link.links.size > 0 -%}
          <button
            type="button"
            class="nav-tree__toggle"
            data-submenu-toggle
            aria-expanded="false"
            aria-controls="{{ submenu_id }}"
            aria-label="{{ 'Show submenu for ' | append: link.title | escape }}"
          >{{ chevron }}</button>
        {%- endif -%}
      </div>

      {%- if link.links.size > 0 -%}
        <ul id="{{ submenu_id }}" class="nav-tree__submenu" role="list">
          {%- for child in link.links -%}
            <li class="nav-tree__subitem">
              <a
                href="{{ child.url }}"
                class="nav-tree__sublink"
                {% if child.active %}aria-current="page"{% endif %}
              >{{ child.title | escape }}</a>

              {%- if child.links.size > 0 -%}
                <ul class="nav-tree__group" role="list">
                  {%- for grandchild in child.links -%}
                    <li>
                      <a
                        href="{{ grandchild.url }}"
                        class="nav-tree__sublink nav-tree__sublink--deep"
                        {% if grandchild.active %}aria-current="page"{% endif %}
                      >{{ grandchild.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
