{%- comment -%} Usage: render 'product-card', product: product {%- endcomment -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

{%- assign is_new = false -%}
{%- assign thirty_days_ago = 'now' | date: '%s' | minus: 2592000 -%}
{%- assign created_seconds = product.created_at | date: '%s' | plus: 0 -%}
{%- if created_seconds > thirty_days_ago -%}
  {%- assign is_new = true -%}
{%- endif -%}

<article class="product-card">
  {%- comment -%}
    The badge sits outside the image link on purpose. That link is
    aria-hidden to stop screen readers announcing the same product twice,
    and anything nested inside it inherits the hiding — which is how
    "Sold Out" and "Sale" used to go unannounced entirely.
  {%- endcomment -%}
  {%- if on_sale -%}
    <span class="product-card__badge">Sale</span>
  {%- elsif product.available == false -%}
    <span class="product-card__badge product-card__badge--secondary">Sold out</span>
  {%- elsif is_new -%}
    <span class="product-card__badge product-card__badge--new">New</span>
  {%- endif -%}

  <a href="{{ product.url }}" class="product-card__image-wrap" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag:
        loading: 'lazy',
        widths: '300,400,600',
        sizes: '(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw',
        alt: product.featured_image.alt | default: product.title
      }}
    {%- else -%}
      <div class="product-card__no-image">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    {%- endif -%}
  </a>

  <div class="product-card__body">
    {%- if settings.show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price{% if on_sale %} product-card__price--on-sale{% endif %}">
      <span class="product-card__price-current">
        {{ product.price | money }}
        {%- if on_sale -%}
          <span class="visually-hidden">, reduced from {{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </span>
      {%- if on_sale -%}
        <span class="product-card__price-compare" aria-hidden="true">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    {%- comment -%}
      Quick add only for single-variant products. A product with real
      variants (color, size, etc.) has no safe default to add — guessing one
      would either be wrong or need its own option picker here, which is a
      bigger feature than "skip the product page." Those get a plain link to
      the page instead, same as the card already offered.

      The add-to-cart JS is the exact same [data-product-form] handler the
      product page form uses (see theme.js) — this is a second instance of
      that same contract, not a new code path.
    {%- endcomment -%}
    {%- if product.has_only_default_variant -%}
      {%- assign quick_add_variant = product.selected_or_first_available_variant -%}
      <form data-product-form class="product-card__quick-add">
        <input type="hidden" name="id" value="{{ quick_add_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          class="btn btn--outline btn--sm product-card__quick-add-btn"
          data-add-to-cart
          {% unless quick_add_variant.available %}disabled{% endunless %}
        >
          {%- if quick_add_variant.available -%}Quick add{%- else -%}Sold out{%- endif -%}
        </button>
        <p class="product-card__quick-add-error" data-add-to-cart-error hidden></p>
      </form>
    {%- else -%}
      <a href="{{ product.url }}" class="btn btn--outline btn--sm product-card__quick-add-btn">Choose options →</a>
    {%- endif -%}
  </div>
</article>
