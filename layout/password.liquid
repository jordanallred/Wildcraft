<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&family=Dancing+Script:wght@500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Playfair Display', Georgia, serif;
      background: #FCF9F4;
      color: #1A100A;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      text-align: center;
    }
    .pw-eyebrow {
      font-family: 'Dancing Script', cursive;
      font-size: 1.125rem;
      color: #C07040;
      margin-bottom: 0.75rem;
    }
    .pw-shop-name {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 400;
      margin-bottom: 1.25rem;
    }
    .pw-tagline {
      font-style: italic;
      color: #9B7B62;
      font-size: 1.125rem;
      margin-bottom: 2.5rem;
    }
    .pw-form { display: flex; flex-direction: column; gap: 0.75rem; max-width: 380px; width: 100%; }
    .pw-form label { font-size: 0.875rem; color: #9B7B62; text-align: left; }
    .pw-form input {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1.5px solid #E5D3BC;
      border-radius: 999px;
      font-family: inherit;
      font-size: 1rem;
      background: #fff;
      color: #1A100A;
    }
    .pw-form input:focus { outline: none; border-color: #C07040; }
    .pw-btn {
      background: #C07040;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 0.875rem 2rem;
      font-size: 1rem;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.2s;
    }
    .pw-btn:hover { background: #A85D2E; }
    .pw-errors { color: #ef4444; font-size: 0.875rem; }
    .pw-divider {
      width: 48px;
      height: 1px;
      background: #E5D3BC;
      margin: 2rem auto;
    }
    .pw-footer { font-size: 0.8125rem; color: #9B7B62; }
  </style>
</head>
<body>
  <p class="pw-eyebrow">Something beautiful is coming</p>
  <h1 class="pw-shop-name">{{ shop.name }}</h1>
  <p class="pw-tagline">Handmade with care — launching soon.</p>

  {%- form 'storefront_password' -%}
    <div class="pw-form">
      <label for="password">Enter password to preview</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Password"
        autofocus
        autocomplete="current-password"
      >
      {%- if form.errors -%}
        <p class="pw-errors">Wrong password — try again.</p>
      {%- endif -%}
      <button type="submit" class="pw-btn">Enter</button>
    </div>
  {%- endform -%}

  <div class="pw-divider"></div>
  <p class="pw-footer">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
</body>
</html>
