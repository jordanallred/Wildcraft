<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0C2340">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400..700&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..700,0..100,0..1;1,9..144,400..700,0..100,0..1&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Assistant', system-ui, sans-serif;
      background: #0C2340;
      color: #FBF7EF;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem;
      text-align: center;
      -webkit-font-smoothing: antialiased;
    }
    .pw-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #A8C4E0;
      margin-bottom: 1rem;
    }
    .pw-shop-name {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(2.125rem, 7vw, 3.75rem);
      font-weight: 500;
      font-variation-settings: 'SOFT' 60, 'WONK' 1;
      line-height: 1.1;
      margin-bottom: 1rem;
      max-width: 14ch;
    }
    .pw-tagline {
      color: rgba(251,247,239,0.72);
      font-size: 1.0625rem;
      line-height: 1.7;
      margin-bottom: 2.5rem;
      max-width: 34ch;
    }
    .pw-form { display: flex; flex-direction: column; gap: 0.75rem; max-width: 380px; width: 100%; }
    .pw-form label { font-size: 0.875rem; color: rgba(251,247,239,0.72); text-align: left; }
    .pw-form input {
      width: 100%;
      padding: 0.8125rem 1.125rem;
      min-height: 48px;
      border: 1.5px solid rgba(168,196,224,0.4);
      border-radius: 999px;
      font-family: inherit;
      font-size: 1rem;
      background: rgba(251,247,239,0.07);
      color: #FBF7EF;
    }
    .pw-form input::placeholder { color: rgba(251,247,239,0.4); }
    .pw-form input:focus { outline: none; border-color: #E87722; }
    /* Ink, not white. White on Auburn orange measures 2.96:1 and fails AA —
       the storefront settled this by measuring and landed on navy at 5.33:1,
       but this layout is standalone and kept the white it started with. */
    .pw-btn {
      background: #E87722;
      color: #0C2340;
      border: none;
      border-radius: 999px;
      padding: 0.875rem 2rem;
      min-height: 48px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.2s;
    }
    .pw-btn:hover { background: #C46214; }
    :focus-visible { outline: 2.5px solid #E87722; outline-offset: 3px; }
    .pw-errors { color: #FCA5A5; font-size: 0.875rem; }
    .pw-divider {
      width: 72px;
      height: 6px;
      margin: 2.5rem auto 1.25rem;
      background:
        repeating-linear-gradient(90deg, rgba(168,196,224,0.55) 0 6px, transparent 6px 12px),
        repeating-linear-gradient(0deg,  rgba(168,196,224,0.55) 0 6px, transparent 6px 12px);
    }
    .pw-footer { font-size: 0.8125rem; color: rgba(251,247,239,0.5); }
    @media (prefers-reduced-motion: reduce) {
      * { transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
  <p class="pw-eyebrow">Opening soon</p>
  <h1 class="pw-shop-name">{{ shop.name }}</h1>
  <p class="pw-tagline">Hand-drawn game-day buttons, made for Auburn Saturdays. Almost ready.</p>

  {%- form 'storefront_password' -%}
    <div class="pw-form">
      <label for="password">Enter password to preview</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Password"
        autofocus
        autocomplete="current-password"
      >
      {%- if form.errors -%}
        <p class="pw-errors">That password didn't match. Check it and try again.</p>
      {%- endif -%}
      <button type="submit" class="pw-btn">Enter</button>
    </div>
  {%- endform -%}

  <div class="pw-divider" aria-hidden="true"></div>
  <p class="pw-footer">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
</body>
</html>
