{%- comment -%}
  Not a live Instagram feed — that needs a Shopify app and API credentials,
  so a real feed would be a promise the theme can't keep. These are photos
  the merchant uploads, each optionally linking to the post.

  The whole section hides itself until there's either a profile link or at
  least one photo, so it can never ship as an empty band.
{%- endcomment -%}

{%- assign has_photos = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.image != blank -%}
    {%- assign has_photos = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if settings.social_instagram != blank or has_photos -%}
  <section class="social-follow section-padding--sm">
    <div class="container">
      <div class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__text">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if has_photos -%}
        <ul class="social-grid" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              <li class="social-grid__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" rel="noopener noreferrer" target="_blank">
                    {{ block.settings.image | image_url: width: 600 | image_tag:
                       loading: 'lazy', widths: '300,450,600',
                       sizes: '(min-width: 768px) 25vw, 50vw',
                       alt: block.settings.alt | default: 'Photo from our Instagram' }}
                  </a>
                {%- else -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag:
                     loading: 'lazy', widths: '300,450,600',
                     sizes: '(min-width: 768px) 25vw, 50vw',
                     alt: block.settings.alt | default: 'Photo from our Instagram' }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if settings.social_instagram != blank -%}
        <div class="social-follow__cta">
          <a href="{{ settings.social_instagram }}" class="btn btn--outline" rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            {{ section.settings.btn_label | default: 'Follow along' }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add your Instagram address under Theme settings → Social media. This section stays hidden until you do, or until you add a photo below."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Out in the wild"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tag us on your game-day fit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We repost our favourites every week."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Follow along"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Links to",
          "info": "Optional. Paste the address of the post."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Photo description",
          "info": "Describe the photo for anyone using a screen reader."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
