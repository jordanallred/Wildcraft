{%- comment -%}
  With one Slide block this renders and behaves exactly like the old fixed
  hero — controls (arrows, dots) and autoplay only show up once there's a
  second slide to move to, so the common one-slide case stays exactly as
  simple as before.

  Layout, background color, text color, and overlay opacity are section-level
  settings shared by every slide on purpose: the point is one consistent look
  across a rotating set of images/messages, not a different layout per slide.
  Each slide only supplies its own image, heading, subheading, and buttons —
  see snippets/hero-slide.liquid for that rendering.

  Every slide's markup exists in the DOM at once; inactive ones are just
  [hidden], which drops them from layout, the accessibility tree, and tab
  order for free. That's also why only the first slide's heading is an <h1>
  (see hero-slide.liquid) — otherwise a 3-slide carousel would carry three
  <h1>s on one page even with two of them hidden.
{%- endcomment -%}

{%- assign layout = section.settings.layout -%}
{%- assign slide_count = section.blocks.size -%}

<section
  class="hero hero--{{ layout }} hero-carousel"
  {%- if layout == 'split' %} style="background:{{ section.settings.bg_color }};"{% endif %}
  data-carousel
  {%- if slide_count > 1 %} data-autoplay{% endif %}
>
  {%- for block in section.blocks -%}
    {%- assign heading_tag = 'h2' -%}
    {%- if forloop.first -%}
      {%- assign heading_tag = 'h1' -%}
    {%- endif -%}
    <div
      class="hero-carousel__slide{% if forloop.first %} is-active{% endif %}{% if block.settings.image == blank %} hero--text-only{% endif %}"
      {%- unless forloop.first %} hidden{% endunless %}
      data-carousel-slide
      {{ block.shopify_attributes }}
    >
      {%- render 'hero-slide',
        layout: layout,
        block: block,
        text_color: section.settings.text_color,
        overlay_opacity: section.settings.overlay_opacity,
        heading_tag: heading_tag
      -%}
    </div>
  {%- endfor -%}

  {%- if slide_count > 1 -%}
    <div class="hero-carousel__controls">
      <button type="button" class="hero-carousel__arrow hero-carousel__arrow--prev" data-carousel-prev aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="hero-carousel__dots" role="tablist" aria-label="Slides">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}"
            data-carousel-dot
            data-index="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
      <button type="button" class="hero-carousel__arrow hero-carousel__arrow--next" data-carousel-next aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centered (full-width)" },
        { "value": "split", "label": "Split (text + image side by side)" }
      ],
      "default": "split",
      "info": "Applies to every slide, so the carousel keeps one consistent look."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (split layout)",
      "default": "#F2EDE4"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text Color (centered layout, slides with an image)",
      "options": [
        { "value": "dark", "label": "Dark (for light images)" },
        { "value": "light", "label": "Light (for dark images)" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image Overlay Opacity (centered layout)",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "default": "Hand-drawn, one at a time"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Every Saturday deserves a button."
        },
        {
          "type": "text",
          "id": "heading_accent",
          "label": "Word to accent",
          "default": "button",
          "info": "This word gets the orange italic where it appears in the heading. Leave empty for no accent."
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Hand-drawn pin-back buttons for game day, bid day, and every tailgate in between."
        },
        {
          "type": "header",
          "content": "Primary Button"
        },
        {
          "type": "text",
          "id": "btn_primary_label",
          "label": "Primary button label",
          "default": "Shop the buttons"
        },
        {
          "type": "url",
          "id": "btn_primary_link",
          "label": "Primary Button Link"
        },
        {
          "type": "header",
          "content": "Secondary Button"
        },
        {
          "type": "text",
          "id": "btn_secondary_label",
          "label": "Secondary button label",
          "default": "My story"
        },
        {
          "type": "url",
          "id": "btn_secondary_link",
          "label": "Secondary Button Link"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
