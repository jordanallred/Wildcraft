{%- assign collection = section.settings.collection -%}
{%- assign product_limit = section.settings.product_limit | default: 4 -%}

<section class="featured-collection section-padding">
  <div class="container">
    <div class="section-header">
      <p class="label">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products limit: product_limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="view-all-wrap">
          <a href="{{ collection.url }}" class="btn btn--outline">
            {{ section.settings.view_all_label | default: 'Shop All' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="featured-collection__empty">
        <p>No products yet — check back soon.</p>
        <a href="/collections/all" class="btn btn--outline">Browse All</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Fresh from the Studio"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stickers, pins, and printables made with care."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View All\" Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View All\" Button Text",
      "default": "Shop the Full Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
