<article class="product-page" itemscope itemtype="https://schema.org/Product" data-section-id="{{ section.id }}">

  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <!-- Variant data for JS to resolve option combos → variant IDs -->
  <script type="application/json" id="ProductVariants-{{ section.id }}">
    {{ product.variants | json }}
  </script>

  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product-page__inner">
      <!-- Gallery -->
      <div class="product-gallery" id="product-gallery-{{ section.id }}">
        <div class="product-gallery__main">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1000 | image_tag:
              id: 'product-gallery-main-image',
              loading: 'eager',
              widths: '600,800,1000',
              sizes: '(min-width: 768px) 50vw, 100vw',
              alt: product.featured_media.alt | default: product.title,
              itemprop: 'image'
            }}
          {%- else -%}
            <div class="product-card__no-image" aria-hidden="true">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs" role="list">
            {%- for media in product.media limit: 8 -%}
              <button class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" role="listitem" aria-label="View image {{ forloop.index }}">
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title, widths: '100,150,200' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        {%- if product.vendor != blank -%}
          <p class="product-info__vendor label">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-info__title" itemprop="name">{{ product.title }}</h1>

        <div id="product-price-{{ section.id }}" class="product-info__price{% if current_variant.compare_at_price > current_variant.price %} product-info__price--sale{% endif %}">
          <span class="product-info__price-current" itemprop="price" content="{{ current_variant.price | divided_by: 100.0 }}">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product-info__price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
          <meta itemprop="availability" content="{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">
        </div>

        {%- form 'product', product, data-product-form: '', data-section-id: section.id -%}
          <!-- Updated by JS when a variant is selected -->
          <input type="hidden" name="id" id="product-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="product-form__variants">
              {%- for option in product.options_with_values -%}
                <div class="product-form__option">
                  <label class="product-form__label">
                    {{ option.name }}:&nbsp;<span class="product-form__selected-value" id="option-value-{{ section.id }}-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </label>
                  <div class="variant-buttons" data-option-index="{{ forloop.index0 }}" data-section-id="{{ section.id }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="variant-btn{% if value == option.selected_value %} is-selected{% endif %}"
                        data-value="{{ value | escape }}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-section-id="{{ section.id }}"
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if section.settings.show_quantity -%}
            <div>
              <label class="product-form__label" for="product-qty-{{ section.id }}">Quantity</label>
              <div class="product-form__quantity">
                <button type="button" class="product-form__qty-btn" data-action="decrease" aria-label="Decrease">−</button>
                <input id="product-qty-{{ section.id }}" class="product-form__qty-input" type="number" name="quantity" value="1" min="1" max="99" aria-label="Quantity">
                <button type="button" class="product-form__qty-btn" data-action="increase" aria-label="Increase">+</button>
              </div>
            </div>
          {%- else -%}
            <input type="hidden" name="quantity" value="1">
          {%- endif -%}

          <div class="product-form__add">
            <button
              type="submit"
              class="btn btn--primary btn--full btn--lg"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
              id="product-submit-{{ section.id }}"
            >
              {%- if current_variant.available -%}
                Add to Cart — {{ current_variant.price | money }}
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product-info__description" itemprop="description">
            {{ product.description }}
          </div>
        {%- endif -%}

        <div class="product-meta">
          {%- if product.type != blank -%}<p>Type: <span>{{ product.type }}</span></p>{%- endif -%}
          {%- if current_variant.sku != blank -%}<p id="product-sku-{{ section.id }}">SKU: <span>{{ current_variant.sku }}</span></p>{%- endif -%}
        </div>
      </div>
    </div>

    {%- if section.settings.show_related and product.collections.first -%}
      {%- assign related_collection = product.collections.first -%}
      {%- assign has_other = false -%}
      {%- for p in related_collection.products -%}
        {%- unless p.id == product.id -%}{%- assign has_other = true -%}{%- break -%}{%- endunless -%}
      {%- endfor -%}
      {%- if has_other -%}
        <div style="border-top:1px solid var(--color-border);margin-top:var(--space-xl);padding-top:var(--space-xl);">
          <div class="section-header">
            <h2>You Might Also Love</h2>
          </div>
          <div class="product-grid">
            {%- for p in related_collection.products limit: 5 -%}
              {%- unless p.id == product.id -%}
                {%- render 'product-card', product: p -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show Quantity Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show Related Products",
      "default": true
    }
  ]
}
{% endschema %}
