{%- comment -%}
  Structured data is JSON-LD at the foot of this file rather than microdata
  sprayed across the markup. The microdata was half-built — an Offer with a
  price and availability but no url, sku, brand, or image — which is exactly
  the shape Search Console reports as an invalid Product. One complete block
  beats attributes scattered over three elements, and it can describe every
  variant instead of only the one that happens to be selected.
{%- endcomment -%}
<article class="product-page" data-section-id="{{ section.id }}">

  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <!-- Variant data for JS to resolve option combos → variant IDs -->
  <script type="application/json" id="ProductVariants-{{ section.id }}">
    {{ product.variants | json }}
  </script>

  {%- comment -%}
    How many of each variant can actually be ordered. Shopify strips
    inventory_quantity out of `product.variants | json` on the storefront, so
    the script has no way to know the cap — which is why the quantity box was
    hardcoded to max="99" and would happily let you ask for six of a
    one-off. Liquid can see the real number, so it gets emitted separately.

    null means uncapped: either the variant isn't tracked, or its policy is to
    keep selling past zero, in which case any quantity is legitimate.
  {%- endcomment -%}
  <script type="application/json" id="ProductInventory-{{ section.id }}">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}":
        {%- if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' -%}
          {{ variant.inventory_quantity | at_least: 0 }}
        {%- else -%}
          null
        {%- endif -%}
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    }
  </script>

  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product-page__inner">
      <!-- Gallery -->
      <div class="product-gallery" id="product-gallery-{{ section.id }}">
        <div class="product-gallery__main">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1000 | image_tag:
              id: 'product-gallery-main-image',
              loading: 'eager',
              widths: '600,800,1000',
              sizes: '(min-width: 768px) 50vw, 100vw',
              alt: product.featured_media.alt | default: product.title
            }}
          {%- else -%}
            <div class="product-card__no-image" aria-hidden="true">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%}
          Gated on media, not images, because the loop below walks media — a
          product with one photo and one video has images.size == 1 and so
          rendered no thumbnails at all, leaving the video unreachable.

          Each thumb carries the full-size sources it should swap in. Letting
          the script reuse the thumbnail's own src, which is what it did,
          dropped a 200px file into a slot painted at up to 1000px.
        {%- endcomment -%}
        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for media in product.media limit: 8 -%}
              {%- assign media_alt = media.alt | default: product.title -%}
              <button
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                aria-label="Show image {{ forloop.index }} of {{ product.media.size }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                data-full-src="{{ media | image_url: width: 1000 }}"
                data-full-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1000 }} 1000w"
                data-full-alt="{{ media_alt | escape }}"
              >
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '100,150,200' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info">
        {%- comment -%}
          Every product is the shop's own, so the vendor line just repeats the
          name in the header. Shares the card setting rather than adding a
          second switch that means the same thing.
        {%- endcomment -%}
        {%- if settings.show_vendor and product.vendor != blank -%}
          <p class="product-info__vendor label">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div id="product-price-{{ section.id }}" class="product-info__price{% if current_variant.compare_at_price > current_variant.price %} product-info__price--sale{% endif %}">
          <span class="product-info__price-current">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="visually-hidden">, reduced from</span>
            <span class="product-info__price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- comment -%}
          The description sits above the buy button, not below three panels of
          boilerplate. It's the only thing on the page about *this* button, so
          burying it under content identical on every product had the page
          saying a great deal and telling you nothing.
        {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="product-info__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- form 'product', product, data-product-form: '', data-section-id: section.id -%}
          <!-- Updated by JS when a variant is selected -->
          <input type="hidden" name="id" id="product-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="product-form__variants">
              {%- for option in product.options_with_values -%}
                <div class="product-form__option">
                  <label class="product-form__label">
                    {{ option.name }}:&nbsp;<span class="product-form__selected-value" id="option-value-{{ section.id }}-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </label>
                  <div class="variant-buttons" data-option-index="{{ forloop.index0 }}" data-section-id="{{ section.id }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="variant-btn{% if value == option.selected_value %} is-selected{% endif %}"
                        data-value="{{ value | escape }}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-section-id="{{ section.id }}"
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if section.settings.show_quantity -%}
            {%- comment -%}
              max is the real stock when it's tracked and set to stop at zero,
              not a flat 99. Shopify would refuse the excess at add-to-cart
              anyway, so the old ceiling only bought the customer a rejection
              after the fact.
            {%- endcomment -%}
            {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
              {%- assign qty_max = current_variant.inventory_quantity | at_least: 1 -%}
            {%- else -%}
              {%- assign qty_max = 99 -%}
            {%- endif -%}
            <div>
              <label class="product-form__label" for="product-qty-{{ section.id }}">Quantity</label>
              <div class="product-form__quantity">
                <button type="button" class="product-form__qty-btn" data-action="decrease" aria-label="Decrease">−</button>
                <input
                  id="product-qty-{{ section.id }}"
                  class="product-form__qty-input"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  max="{{ qty_max }}"
                  inputmode="numeric"
                  aria-label="Quantity"
                >
                <button type="button" class="product-form__qty-btn" data-action="increase" aria-label="Increase">+</button>
              </div>
              {%- comment -%}
                Says why the stepper stops. Hidden by default and revealed by
                the script when you reach the ceiling, so it reads as an
                explanation rather than a warning nobody asked for.
              {%- endcomment -%}
              <p class="product-form__stock" data-qty-limit hidden></p>
            </div>
          {%- else -%}
            <input type="hidden" name="quantity" value="1">
          {%- endif -%}

          <div class="product-form__add">
            <button
              type="submit"
              class="btn btn--primary btn--full btn--lg"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
              id="product-submit-{{ section.id }}"
            >
              {%- if current_variant.available -%}
                Add to cart — {{ current_variant.price | money }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>
            {%- comment -%}
              This promised "New buttons land before every home game" — a
              release schedule nobody agreed to. She draws when inspiration or
              a request strikes, so it says nothing about timing now.
            {%- endcomment -%}
            <p class="product-form__note" id="product-note-{{ section.id }}"{% if current_variant.available %} hidden{% endif %}>
              Sold out for now.
            </p>
            {%- comment -%}
              Where a rejected add lands. Shopify turns one down more often
              than you'd think — stock going in the few seconds between page
              load and click, or a quantity above what's left — and until now
              the only sign was a line in the console.
            {%- endcomment -%}
            <p class="product-form__error" data-add-to-cart-error role="alert" hidden></p>
          </div>
        {%- endform -%}

        {%- comment -%}
          Specs come from the product's own `custom.details` metafield, not
          from a theme setting. Three accordions used to sit here restating
          the same "2.25-inch pin-back button" on every page — which is both
          repetition and a trap, because it stops being true the moment the
          catalogue grows past buttons. A sticker or a print carries its own
          list; anything with nothing to say shows nothing.
        {%- endcomment -%}
        {%- assign spec_list = product.metafields.custom.details.value -%}
        {%- if spec_list != blank -%}
          <ul class="product-specs" role="list">
            {%- for spec in spec_list -%}
              <li>{{ spec }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%}
          One line and three links, rather than paragraphs paraphrasing the
          policies. The policy pages are the real thing and stay correct on
          their own; restating them here just created a second copy to keep in
          step, and the two drift.
        {%- endcomment -%}
        <div class="product-policies">
          {%- if section.settings.fulfillment_note != blank -%}
            <p class="product-policies__note">{{ section.settings.fulfillment_note }}</p>
          {%- endif -%}
          <p class="product-policies__links">
            {%- if shop.shipping_policy.url != blank -%}
              <a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>
            {%- endif -%}
            {%- if shop.refund_policy.url != blank -%}
              <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>
            {%- endif -%}
            {%- if pages['contact'].handle != blank -%}
              <a href="{{ pages['contact'].url }}">Questions?</a>
            {%- endif -%}
          </p>
        </div>

        {%- if current_variant.sku != blank -%}
          <p class="product-meta" id="product-sku-{{ section.id }}">SKU: <span>{{ current_variant.sku }}</span></p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_related and product.collections.first -%}
      {%- assign related_collection = product.collections.first -%}
      {%- assign has_other = false -%}
      {%- for p in related_collection.products -%}
        {%- unless p.id == product.id -%}{%- assign has_other = true -%}{%- break -%}{%- endunless -%}
      {%- endfor -%}
      {%- if has_other -%}
        <div class="product-related">
          <div class="section-header section-header--center">
            <h2>More from the shop</h2>
          </div>
          <div class="product-grid">
            {%- for p in related_collection.products limit: 5 -%}
              {%- unless p.id == product.id -%}
                {%- render 'product-card', product: p -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

<!-- Sticky Add-to-Cart: mobile only, appears when main button scrolls out of view.
     Starts inert — it is only pushed off-screen with a transform, so without
     that its button sat in the tab order the whole way down the page. -->
<div class="product-sticky-bar" id="product-sticky-bar" aria-hidden="true" inert>
  <div class="product-sticky-bar__inner">
    <div class="product-sticky-bar__info">
      <span class="product-sticky-bar__title">{{ product.title | truncate: 40 }}</span>
      <span class="product-sticky-bar__price">{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="btn btn--primary product-sticky-bar__btn" id="sticky-add-to-cart"{% unless current_variant.available %} disabled{% endunless %}>
      {%- if current_variant.available -%}Add to Cart{%- else -%}Sold out{%- endif -%}
    </button>
  </div>
</div>

{%- comment -%}
  One Offer per variant, so a search result can show a range rather than
  whichever variant happened to be selected when the crawler called. The `json`
  filter does the escaping — a product title with an apostrophe or a quote in
  it would otherwise break the block, and this shop's titles are exactly the
  sort that contain both.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.description != blank %}
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  {%- endif %}
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if product.featured_media %}
  "image": [
    {%- for media in product.media limit: 5 -%}
      {{ media | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: variant.url | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      {%- if variant.barcode != blank %}
      "gtin": {{ variant.barcode | json }},
      {%- endif %}
      "name": {{ variant.title | json }},
      "itemCondition": "https://schema.org/NewCondition"
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show more products from the shop",
      "default": true
    },
    {
      "type": "header",
      "content": "Under the buy button"
    },
    {
      "type": "paragraph",
      "content": "Specs live on each product, under Product details → Details, so a sticker or a print can describe itself differently from a button. Shipping and returns link to your policy pages rather than repeating them here."
    },
    {
      "type": "text",
      "id": "fulfillment_note",
      "label": "One-line note",
      "default": "Made to order — allow 2–3 business days before it ships.",
      "info": "Appears on every product, above the policy links. Leave empty to hide it."
    }
  ]
}
{% endschema %}
