<div class="collection-page">
  <div class="container">

    <div class="collection-page__header">
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="collection-page__desc">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    <div class="collection-toolbar">
      <p class="collection-toolbar__count">
        {{ collection.products_count }}
        {%- if collection.products_count == 1 -%} product{%- else -%} products{%- endif -%}
      </p>
      {%- comment -%}
        A real GET form rather than `onchange="window.location = '?sort_by=' …"`.
        That inline handler rebuilt the query string from nothing, so sorting
        from page 3 silently dropped `?page=3` — and it left the select with no
        working state for anyone without JS.

        The options come from collection.sort_options, not a hardcoded list, so
        they match what this shop actually offers. The old list was missing
        Best selling and Oldest, and offered Featured on collections that are
        not manually sorted, where Shopify ignores it.
      {%- endcomment -%}
      {%- if section.settings.show_sort and collection.sort_options.size > 0 -%}
        {%- assign sort_current = collection.sort_by | default: collection.default_sort_by -%}
        <form method="get" action="{{ collection.url }}" class="collection-toolbar__sort" data-auto-submit>
          <label for="sort-by">Sort by</label>
          <select name="sort_by" id="sort-by">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_current %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="btn btn--outline btn--sm">Sort</button></noscript>
        </form>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="btn btn--outline btn--sm" rel="prev">← Previous</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="btn btn--outline btn--sm" aria-label="Page {{ part.title }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="btn btn--primary btn--sm" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="btn btn--outline btn--sm pagination__gap" aria-hidden="true">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="btn btn--outline btn--sm" rel="next">Next →</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="collection-page__empty">No products found in this collection.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per Page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort Dropdown",
      "default": true
    }
  ]
}
{% endschema %}
