<div class="collection-page">
  <div class="container">

    <div class="collection-page__header">
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="collection-page__desc">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      Filters and sort share one GET form and one submit, so applying a
      filter doesn't reset the sort order (or vice versa) the way two
      separate forms fighting over the same query string would.

      collection.filters comes from whatever's configured as a storefront
      filter in Admin → Search & Discovery — it's empty until that's set up,
      in which case this renders no filter groups and behaves exactly like
      the old sort-only toolbar. Nothing here needs an app or a hardcoded
      list of tags to keep working as that configuration changes.
    {%- endcomment -%}
    {%- assign sort_current = collection.sort_by | default: collection.default_sort_by -%}
    <form method="get" action="{{ collection.url }}" class="collection-toolbar" data-auto-submit>
      <div class="collection-toolbar__row">
        <p class="collection-toolbar__count">
          {{ collection.products_count }}
          {%- if collection.products_count == 1 -%} product{%- else -%} products{%- endif -%}
        </p>
        {%- if section.settings.show_sort and collection.sort_options.size > 0 -%}
          <div class="collection-toolbar__sort">
            <label for="sort-by">Sort by</label>
            <select name="sort_by" id="sort-by">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_current %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_filters and collection.filters.size > 0 -%}
        {%- assign has_active_filters = false -%}
        {%- for filter in collection.filters -%}
          {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}
            {%- assign has_active_filters = true -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="collection-filters">
          {%- for filter in collection.filters -%}
            <details class="collection-filters__group"{% if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil %} open{% endif %}>
              <summary class="collection-filters__summary">
                {{ filter.label }}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
              </summary>

              {%- case filter.type -%}
                {%- when 'list' or 'boolean' -%}
                  <ul class="collection-filters__options" role="list">
                    {%- for filter_value in filter.values -%}
                      {%- if filter_value.count > 0 or filter_value.active -%}
                        <li class="collection-filters__option">
                          <label>
                            <input
                              type="checkbox"
                              name="{{ filter_value.param_name }}"
                              value="{{ filter_value.value }}"
                              {% if filter_value.active %}checked{% endif %}
                              data-auto-submit-input
                            >
                            {{ filter_value.label }} ({{ filter_value.count }})
                          </label>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="collection-filters__price">
                    <label class="collection-filters__price-field">
                      <span class="visually-hidden">Minimum price</span>
                      {{ cart.currency.symbol }}
                      <input
                        type="number"
                        name="{{ filter.min_value.param_name }}"
                        value="{{ filter.min_value.value }}"
                        placeholder="{{ filter.range_min | money_without_currency }}"
                        min="0"
                        data-auto-submit-input
                      >
                    </label>
                    <span aria-hidden="true">–</span>
                    <label class="collection-filters__price-field">
                      <span class="visually-hidden">Maximum price</span>
                      {{ cart.currency.symbol }}
                      <input
                        type="number"
                        name="{{ filter.max_value.param_name }}"
                        value="{{ filter.max_value.value }}"
                        placeholder="{{ filter.range_max | money_without_currency }}"
                        min="0"
                        data-auto-submit-input
                      >
                    </label>
                  </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}

          {%- if has_active_filters -%}
            <a href="{{ collection.url }}{% if sort_current != collection.default_sort_by %}?sort_by={{ sort_current }}{% endif %}" class="collection-filters__clear">
              Clear all
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <noscript><button type="submit" class="btn btn--outline btn--sm">Apply</button></noscript>
    </form>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="btn btn--outline btn--sm" rel="prev">← Previous</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="btn btn--outline btn--sm" aria-label="Page {{ part.title }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="btn btn--primary btn--sm" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="btn btn--outline btn--sm pagination__gap" aria-hidden="true">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="btn btn--outline btn--sm" rel="next">Next →</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="collection-page__empty">No products found in this collection.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per Page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort Dropdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Filters",
      "default": true,
      "info": "Filters are configured in Search & Discovery under Admin → Online Store. Nothing shows here until at least one is set up there."
    }
  ]
}
{% endschema %}
