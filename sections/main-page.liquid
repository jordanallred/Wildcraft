{%- comment -%}
  Page content, with an optional portrait beside it.

  The image is a section setting rather than something pasted into the page
  body, so it can be swapped in the theme editor without editing HTML, and so
  it sits in a layout the stylesheet controls. Only templates that set one get
  one — the Contact page keeps using this same section and shows nothing.

  On wide screens the photo is set into the writing and the prose wraps around
  and closes back over beneath it. On a phone there is no room to wrap, so it
  stops floating and leads the page instead.

  The `sizes` value below has to agree with the float width in the stylesheet.
  Shopify picks which rendition to serve from `sizes`, so if the CSS grows the
  photo and this does not, the page gets a larger blurry image rather than a
  larger sharp one.
{%- endcomment -%}

{%- assign has_portrait = false -%}
{%- if section.settings.image != blank -%}
  {%- assign has_portrait = true -%}
{%- endif -%}

<div class="container">
  <div class="page-content{% if has_portrait %} page-content--portrait{% endif %}">
    <h1 class="page-content__title">{{ page.title }}</h1>

    {%- if has_portrait -%}
      <figure class="page-portrait">
        {{ section.settings.image
           | image_url: width: 800
           | image_tag:
             loading: 'eager',
             widths: '300,450,600,800',
             sizes: '(min-width: 768px) 360px, 100vw',
             alt: section.settings.image_alt | default: page.title }}
        {%- if section.settings.caption != blank -%}
          <figcaption>{{ section.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    {%- if page.handle == 'contact' -%}
      <div class="rte page-content__body">
        <p>Got a question, or a design you'd love to see? Send it below and I'll get back to you within 1-2 business days.</p>
        <p>During football season things get busy, so if it's about a game day deadline, give me as much notice as you can.</p>
      </div>

      {%- form 'contact', id: 'ContactForm', class: 'design-request-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="design-request-form__success" tabindex="-1">
            Got it - thank you! I read every message myself.
          </p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="design-request-form__errors">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[Subject]" value="Contact page">

          <div class="design-request-form__field">
            <label for="ContactFormEmail">Your email</label>
            <input
              type="email"
              id="ContactFormEmail"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              required
            >
          </div>

          <div class="design-request-form__field">
            <label for="ContactFormBody">Message</label>
            <textarea
              id="ContactFormBody"
              name="contact[body]"
              rows="6"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--lg">Send message</button>
        {%- endif -%}
      {%- endform -%}
    {%- else -%}
      <div class="rte page-content__body">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Optional. Sits beside the writing on wide screens and above it on a phone. A portrait or square crop works best."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description",
      "info": "Read aloud by screen readers and shown if the image fails to load. Say who or what is in the picture."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Optional line under the photo."
    }
  ]
}
{% endschema %}
