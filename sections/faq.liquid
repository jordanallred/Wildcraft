{%- comment -%}
  Native <details>/<summary>. Keyboard operable, findable by in-page search,
  and works with JavaScript off — none of which is true of a scripted
  accordion, and it needs no code to maintain.
{%- endcomment -%}

<section class="faq section-padding">
  <div class="container">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-header__text">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            <svg class="faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_text != blank -%}
      <p class="faq__footer">{{ section.settings.footer_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Questions",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Closing note",
      "default": "<p>Still stuck? <a href=\"/pages/contact\">Send me a note</a> and I'll get back to you.</p>"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Tell your customers how long orders take to pack and arrive.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Questions",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How big are the buttons?",
            "answer": "<p>Add the diameter and the pin-back style here so people know what they're getting.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Tell customers how long you take to pack an order and roughly how long delivery runs.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I order for my whole chapter?",
            "answer": "<p>Yes. Explain your bulk pricing and the lead time you need for a big order.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if something arrives damaged?",
            "answer": "<p>Say what you'll do and how long customers have to tell you.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
