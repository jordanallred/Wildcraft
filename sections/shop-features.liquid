<section class="shop-features section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__text">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="features-grid">
      {%- for block in section.blocks -%}
        <div class="feature-item" {{ block.shopify_attributes }}>
          <div class="feature-item__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'download' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {%- when 'heart' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- when 'star' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- when 'package' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              {%- when 'leaf' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 22c2.6-1.4 5.3-2 8.18-2 3.6 0 6.6 1.3 9-1.33 2.4-2.66 3-8 3-13S17 4 17 4z"/></svg>
              {%- when 'pin' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.25"/></svg>
              {%- when 'gift' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"/><line x1="12" y1="8" x2="12" y2="21"/><path d="M12 8S10.5 3 8 3a2.5 2.5 0 0 0 0 5zM12 8s1.5-5 4-5a2.5 2.5 0 0 1 0 5z"/></svg>
              {%- when 'truck' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16V6a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10"/><path d="M15 9h4l2 3v4h-6"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="feature-item__title">{{ block.settings.title }}</h3>
          <p class="feature-item__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Features",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Small shop, real hands"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "pin", "label": "Button" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Shipping" },
            { "value": "star", "label": "Star" },
            { "value": "package", "label": "Package" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "download", "label": "Download" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Drawn by hand"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every design starts as an original drawing. No clip art, no templates."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "title": "Drawn by hand",
            "text": "Every design starts as an original drawing. No clip art, no templates."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "pin",
            "title": "Made to be worn",
            "text": "Sturdy pin backs and a scratch-resistant finish, so they live on your bag and not in a drawer."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "gift",
            "title": "Tell me what to draw",
            "text": "What people ask for is a big part of what gets drawn next."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "truck",
            "title": "Packed by hand",
            "text": "Every order is padded and packed by hand before it leaves the studio."
          }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
