<section class="shop-features section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="features-grid">
      {%- for block in section.blocks -%}
        <div class="feature-item" {{ block.shopify_attributes }}>
          <div class="feature-item__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'download' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {%- when 'heart' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- when 'star' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- when 'package' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              {%- when 'leaf' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 22c2.6-1.4 5.3-2 8.18-2 3.6 0 6.6 1.3 9-1.33 2.4-2.66 3-8 3-13S17 4 17 4z"/></svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="feature-item__title">{{ block.settings.title }}</h3>
          <p class="feature-item__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why Shop With Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "download", "label": "Download" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "package", "label": "Package" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Made with Love"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every item is crafted with intention and Southern heart."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "download",
            "title": "Instant Downloads",
            "text": "Digital items delivered to your inbox the moment you check out — no waiting."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "title": "Handmade with Care",
            "text": "Physical goods are made by hand, one at a time, with real attention to detail."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "star",
            "title": "Quality You Can Feel",
            "text": "From the paper stock to the pin backs — materials that look and last beautifully."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "package",
            "title": "Thoughtful Packaging",
            "text": "Orders are packed with care and a personal touch before they leave our hands."
          }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
