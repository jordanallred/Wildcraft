{%- comment -%}
  Three states, never a blank page. Everything here used to sit behind
  `search.performed`, so landing on /search with no query rendered a lone
  input on an empty page — and the header's search icon links straight here,
  which made that the common case rather than the edge case. A query with no
  hits falls through to the same catalogue rather than dead-ending.
{%- endcomment -%}

<div class="search-page">
  <div class="container">

    <div class="search-page__header">
      <h1 class="search-page__heading">Search</h1>

      <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
        <span class="search-form__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
          </svg>
        </span>
        {%- comment -%}
          No autofocus: it opens the keyboard and jump-scrolls the page on
          load, and this shop's traffic is overwhelmingly mobile.
        {%- endcomment -%}
        <input
          type="search"
          name="q"
          class="search-form__input"
          value="{{ search.terms | escape }}"
          placeholder="Search the shop&hellip;"
          aria-label="Search"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn btn--primary search-form__submit">Search</button>
      </form>
    </div>

    {%- if search.performed and search.results_count > 0 -%}

      <p class="search-page__count">
        {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
        for &ldquo;<span class="search-page__term">{{ search.terms | escape }}</span>&rdquo;
      </p>

      {%- paginate search.results by 24 -%}
        <div class="product-grid">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {%- render 'product-card', product: result -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="btn btn--outline btn--sm" rel="prev">← Previous</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="btn btn--outline btn--sm" aria-label="Page {{ part.title }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="btn btn--primary btn--sm" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="btn btn--outline btn--sm pagination__gap" aria-hidden="true">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="btn btn--outline btn--sm" rel="next">Next →</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

    {%- else -%}

      {%- if search.performed -%}
        <div class="search-page__empty">
          <p class="search-page__empty-title">
            No results for &ldquo;<span class="search-page__term">{{ search.terms | escape }}</span>&rdquo;
          </p>
          <p class="search-page__empty-note">
            Try a shorter term, or a word from the button's name.
          </p>
        </div>
      {%- endif -%}

      <p class="search-page__count">Browse the whole shop</p>

      {%- comment -%}
        Deliberately unpaginated. Shopify caps an un-paginated products loop at
        50, which is the guard here — an explicit smaller `limit` would make
        "the whole shop" untrue the moment the catalogue outgrew it.
      {%- endcomment -%}
      <div class="product-grid">
        {%- for product in collections.all.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
