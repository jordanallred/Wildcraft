<div class="container">
  <div class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">Page Not Found</h1>
    <p class="not-found__text">
      The page you're looking for has moved, or maybe it never existed.<br>
      Let's get you back on track.
    </p>
    <div class="not-found__actions">
      <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg">Go Home</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline btn--lg">Shop All</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Not Found",
  "settings": []
}
{% endschema %}
