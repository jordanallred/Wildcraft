{%- comment -%}
  The intro banner at the top of a school's collection page (see
  templates/collection.arkansas.json). Everything here — heading, welcome
  copy, colors — comes from that collection's metafields rather than
  section settings, so a second or third school is an admin task (create a
  collection, set its metafields) instead of a new template + new section
  settings. See docs/superpowers/specs/2026-08-15-multi-school-expansion-design.md.

  The color override lives on this section's own wrapper as inline custom
  properties. Everything downstream — the product grid, the filter panel,
  buttons — already reads var(--color-primary) etc. rather than a hardcoded
  Auburn hex, so nothing else needs to know it's rendering for a different
  school; the override just needs to still be in scope where those
  components render. main-collection.liquid sits inside the same
  .school-page wrapper for that reason (see the template).
{%- endcomment -%}

{%- assign heading = collection.metafields.custom.school_heading.value -%}
{%- assign welcome = collection.metafields.custom.school_welcome.value -%}
{%- assign primary_color = collection.metafields.custom.school_primary_color.value -%}
{%- assign accent_color = collection.metafields.custom.school_accent_color.value -%}

<div
  class="school-hero"
  {%- if primary_color or accent_color %} style="{% if primary_color %}--color-primary: {{ primary_color }}; --color-primary-hover: {{ primary_color }};{% endif %}{% if accent_color %} --color-accent-ink: {{ accent_color }}; --color-accent: {{ accent_color }};{% endif %}"{% endif %}
>
  <div class="container">
    {%- if heading != blank -%}
      <h1 class="school-hero__heading">{{ heading }}</h1>
    {%- endif -%}
    {%- if welcome != blank -%}
      {%- assign welcome_lines = welcome | newline_to_br | split: '<br />' -%}
      <div class="school-hero__welcome rte">
        {%- for line in welcome_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}
            <p>{{ trimmed }}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if pages['find-your-school'] -%}
      <a href="{{ pages['find-your-school'].url }}" class="school-hero__other-schools">← Shop for another school</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "School Collection Hero",
  "settings": []
}
{% endschema %}
