<section class="about-banner section-padding">
  <div class="container">
    <div class="about-banner__inner{% if section.settings.image != blank and section.settings.image_position == 'right' %} about-banner__inner--reversed{% endif %}{% if section.settings.image == blank %} about-banner__inner--text-only{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="about-banner__image">
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '500,700,900', sizes: '45vw', alt: section.settings.heading }}
        </div>
      {%- endif -%}
      <div class="about-banner__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="about-banner__eyebrow label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="about-banner__title">{{ section.settings.heading }}</h2>
        <p class="about-banner__text">{{ section.settings.text }}</p>
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link }}" class="btn btn--primary">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About / Story Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in craft, raised on Southern charm."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Every piece in this shop comes from a place of genuine love for making things. Inspired by the deep tradition of craftsmanship and the warmth of Southern life, each design is created to be something you hold onto."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "About / Story Banner"
    }
  ]
}
{% endschema %}
