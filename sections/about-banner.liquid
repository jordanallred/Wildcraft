<section class="about-banner section-padding">
  <div class="container">
    <div class="about-banner__inner{% if section.settings.image != blank and section.settings.image_position == 'right' %} about-banner__inner--reversed{% endif %}{% if section.settings.image == blank %} about-banner__inner--text-only{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="about-banner__image">
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '500,700,900', sizes: '45vw', alt: section.settings.heading }}
        </div>
      {%- endif -%}
      <div class="about-banner__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="about-banner__eyebrow label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="about-banner__title">{{ section.settings.heading }}</h2>
        {%- comment -%}
          newline_to_br: the setting is a textarea, so a merchant who breaks
          the story into two paragraphs got one run-on block.
        {%- endcomment -%}
        <p class="about-banner__text">{{ section.settings.text | newline_to_br }}</p>
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link }}" class="btn btn--primary">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About / Story Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "My story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "It started with one button and one football game."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "It began with a single design drawn for one Saturday, and a friend who wanted one too. Every button in the shop still starts the same way: a pen, a blank circle, and something worth wearing on your bag."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Read my story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "About / Story Banner"
    }
  ]
}
{% endschema %}
